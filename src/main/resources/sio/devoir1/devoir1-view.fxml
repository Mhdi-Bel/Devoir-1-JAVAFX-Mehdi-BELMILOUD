<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sio.devoir1.Devoir1Controller">

    <!-- Titre -->

    <top>
        <HBox alignment="CENTER">
            <padding>
                <Insets top="15" bottom="15"/>
            </padding>
            <Label text="Gestion des tournois eSport"
                   styleClass="titre"/>
        </HBox>
    </top>

    <!-- TreeView -->

    <left>
        <VBox prefWidth="300"
              spacing="10"
              styleClass="panneau">
            <padding>
                <Insets top="10" right="10"
                        bottom="10" left="10"/>
            </padding>
            <Label text="Tournois et équipes"/>
            <TreeView fx:id="tvTournois"
                      VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <!-- Zone centrale -->

    <center>

        <VBox alignment="CENTER"
              spacing="15"
              styleClass="panneau">
            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>
            <HBox alignment="CENTER" spacing="20">
                <VBox spacing="10">
                    <Label text="Liste des tournois"/>
                    <ComboBox fx:id="cbTournois"
                              onAction="#chargerEquipes"
                              prefWidth="200"/>
                </VBox>
                <VBox spacing="10">
                    <Label text="Liste des équipes"/>
                    <ComboBox fx:id="cbEquipes"
                              prefWidth="200"/>
                </VBox>
            </HBox>
            <Separator/>
            <Label text="Nom de la nouvelle équipe"/>
            <TextField fx:id="txtEquipe"
                       promptText="Nom équipe"
                       maxWidth="250"/>
            <Button text="Ajouter équipe"
                    onAction="#ajouterEquipe"/>
            <Separator/>
            <Label text="Score à ajouter"/>
            <TextField fx:id="txtScore"
                       promptText="Score"
                       maxWidth="250"/>
            <Button text="Ajouter score"
                    onAction="#ajouterScore"/>
            <Separator/>
            <Button text="Renommer équipe"
                    onAction="#renommerEquipe"/>
            <Separator/>
            <HBox spacing="10"
                  alignment="CENTER">
                <Button text="Total tournoi"
                        onAction="#calculTotalTournoi"/>
                <Button text="Meilleure équipe"
                        onAction="#meilleureEquipe"/>
            </HBox>
        </VBox>
    </center>
    <!-- Résultats -->
    <bottom>
        <HBox alignment="CENTER">
            <padding>
                <Insets top="10"
                        right="10"
                        bottom="10"
                        left="10"/>
            </padding>
            <Label text="Résultat : "/>
            <Label fx:id="lblResultat"
                   text=""/>
        </HBox>
    </bottom>
</BorderPane>